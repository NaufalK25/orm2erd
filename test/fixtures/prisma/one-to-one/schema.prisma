datasource db {
  provider = "postgresql"
}

// Required 1-1: Profile owns the FK, and it's NOT NULL -> isFromOptional: false.
model User {
  id      Int      @id @default(autoincrement())
  profile Profile?
}

model Profile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])
}

// Optional 1-1: Transaction owns the FK, and it's nullable -> isFromOptional: true.
model Customer {
  id          Int          @id @default(autoincrement())
  transaction Transaction?
}

model Transaction {
  id         Int       @id @default(autoincrement())
  customerId Int?      @unique
  customer   Customer? @relation(fields: [customerId], references: [id])
}
