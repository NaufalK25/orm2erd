// Entities
Table User {
  id int [pk, not null]
  email string [unique, not null]
  name string [not null, note: "The user's display name."]
  Note: "Registered application users."
}

Table Tag {
  id int [pk, not null]
  name string [unique, not null]
}

Table Profile {
  id int [pk, not null]
  bio string
  user_id int [not null]
}

Table Post {
  id int [pk, not null]
  title string [not null]
  content string
  author_id int [not null]

  indexes {
    title
  }
}

// Relationships
Ref: User.id > Post.author_id [delete: cascade, update: cascade]
Ref: User.id - Profile.user_id [delete: cascade]